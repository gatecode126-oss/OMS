{
  "name": "office-management",
  "version": "2.0.0",
  "private": true,
  "description": "Gatecode OMS — Next.js (App Router) frontend + Express API + Socket.IO served from one custom Node server",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "nodemon --watch server.js --watch src/server --ext js,mjs,json --ignore src/server/scripts server.js",
    "build": "next build",
    "start": "node server.js --prod",
    "lint": "eslint .",
    "create-admin": "node src/server/scripts/create-super-admin.js"
  },
  "dependencies": {
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "2.4.3",
    "buffer": "6.0.3",
    "compression": "^1.8.1",
    "cors": "2.8.6",
    "date-fns": "^4.4.0",
    "dompurify": "3.4.11",
    "dotenv": "16.6.1",
    "emoji-mart": "5.6.0",
    "emoji-picker-react": "4.19.1",
    "express": "4.22.2",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "highlight.js": "11.11.1",
    "html2canvas": "1.4.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.17.0",
    "markdown-it": "14.2.0",
    "mongoose": "8.24.0",
    "morgan": "1.10.1",
    "next": "16.4.6",
    "puppeteer-core": "^25.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0",
    "react-infinite-scroll-component": "7.2.1",
    "react-is": "19.2.7",
    "recharts": "3.8.1",
    "redis": "6.0.0",
    "simple-peer": "9.11.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "web-push": "3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14"
  }
}
