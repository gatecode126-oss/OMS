# ─── SERVER CONFIGURATION ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE CONFIGURATION (FUTURE INTEGRATION) ──────────────────────────────
# Replace with actual MongoDB connection string when deploying
DB_URI=mongodb://localhost:27017/office_management_db

# ─── SECURITY & SECRETS ───────────────────────────────────────────────────────
# Replace with a robust custom secure key for JWT tokens
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── CLIENT CONNECTION ────────────────────────────────────────────────────────
# Origin allowed by CORS settings
CLIENT_URL=http://localhost:5000

# ── Next.js (optional) ─────────────────────────────────────────────
# The web app and API are served from the same origin by server.js, so these
# are only needed when the API lives on a different host.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=

# Opt-in: write every update payload to logs/security_debug.log (debug only)
# SECURITY_DEBUG_LOG=true
